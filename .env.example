# DreamForge AI - Local Environment Variables Configuration
# Copy this file to '.env' and fill in your actual keys.

# Gemini API Key (Required - Get it from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Search API Key (Optional - Used for premium competitor web crawls)
TAVILY_API_KEY=your_tavily_api_key_here
